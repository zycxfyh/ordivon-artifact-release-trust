{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Sigstore Attestation Trust Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "id", "acceptedBundleMediaTypes", "signers"],
  "properties": {
    "policyVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "acceptedBundleMediaTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "application/vnd.dev.sigstore.bundle.v0.3+json"}
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/signer"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "digestBoundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "githubActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflowRef", "ref", "shaAuthority", "name", "trigger"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "workflowRef": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+/\\.github/workflows/[^@\\s]+@.+$"},
        "ref": {"type": "string", "minLength": 1},
        "shaAuthority": {"enum": ["policy", "runtime"]},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "name": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"shaAuthority": {"const": "policy"}}, "required": ["shaAuthority"]},
          "then": {"required": ["sha"]}
        },
        {
          "if": {"properties": {"shaAuthority": {"const": "runtime"}}, "required": ["shaAuthority"]},
          "then": {"not": {"required": ["sha"]}}
        }
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "requireTransparencyLog"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "mode": {"enum": ["public-key", "keyless"]},
        "allowedVerifierIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "allowedBuilderIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "requireTransparencyLog": {"type": "boolean"},
        "publicKey": {"$ref": "#/$defs/digestBoundFile"},
        "certificateIdentity": {"type": "string", "minLength": 1},
        "certificateOidcIssuer": {"type": "string", "format": "uri"},
        "githubActions": {"$ref": "#/$defs/githubActions"},
        "trustedRoot": {"$ref": "#/$defs/digestBoundFile"}
      },
      "anyOf": [
        {"required": ["allowedVerifierIds"]},
        {"required": ["allowedBuilderIds"]}
      ],
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "public-key"}}, "required": ["mode"]},
          "then": {"required": ["publicKey"]}
        },
        {
          "if": {"properties": {"mode": {"const": "keyless"}}, "required": ["mode"]},
          "then": {
            "required": ["certificateIdentity", "certificateOidcIssuer"],
            "properties": {"requireTransparencyLog": {"const": true}}
          }
        },
        {
          "if": {
            "properties": {
              "mode": {"const": "keyless"},
              "certificateOidcIssuer": {"const": "https://token.actions.githubusercontent.com"}
            },
            "required": ["mode", "certificateOidcIssuer"]
          },
          "then": {"required": ["githubActions"]}
        }
      ]
    }
  }
}
